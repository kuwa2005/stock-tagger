# Stock Image Auto Tagger 環境変数
# コピー: cp .env.example .env

# API サーバーポート（SD WebUI 7860 と競合回避のため 7861 推奨）
WEBUI_PORT=7861

# 待ち受けアドレス（既定: 127.0.0.1 = このマシンからのみ接続可）
# API に認証はありません。LAN 公開時はリバースプロキシ等でアクセス制限を行ってください。
# BIND_ADDRESS=0.0.0.0

# HuggingFace モデルキャッシュ（オプション: ボリュームマウントで永続化）
# HF_HOME=/data/hf_cache

# 使用GPU（複数ある場合: 0,1 等）
# NVIDIA_VISIBLE_DEVICES=0

# RAM++ を無効化（VRAM 不足時: false）
# USE_RAM=false

# 外部翻訳 API（MyMemory）による日本語表示フォールバック。
# 有効にするとキャプション文が外部サービスへ送信されます。社内承認を確認のうえ有効化してください。
# ENABLE_EXTERNAL_TRANSLATE=false

# 起動時にモデルを事前ロード（/ready で準備完了を確認）
# PRELOAD_MODELS=true

# アップロード制限
# MAX_UPLOAD_MB=50
# MAX_FILES_PER_REQUEST=50

# キーワード数の既定値（API の max_keywords で 1〜100 を指定可。Adobe Stock は最大 49）
# MAX_KEYWORDS=20

# キャプション生成パラメータ（小さくすると高速化）
# CAPTION_MAX_NEW_TOKENS=256
# CAPTION_NUM_BEAMS=3
